{
  "name": "karin-browser",
  "version": "1.0.0",
  "description": "Karin Browser - Lightweight Open-Source Custom Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": ["browser", "electron", "open-source"],
  "author": "Your Name",
  "license": "MIT",
  "build": {
    "appId": "com.karin.browser",
    "productName": "Karin Browser",
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}